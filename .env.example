# WhatsApp Cloud API (Meta) — real outbound delivery for security dispatch.
# Copy to .env in this same folder. Never commit .env.
# Leave blank to keep notifications in the local review queue (the app will
# report "configured: false" truthfully rather than pretending to send).

WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_DEMO_RECIPIENT=27826502010

# Free-tier service text. Set WHATSAPP_CLOUD_MESSAGE_TEXT to send a plain service
# message (free within a 24h service window) instead of a billable template.
WHATSAPP_CLOUD_MESSAGE_TEXT=
WHATSAPP_CLOUD_TEMPLATE_NAME=mzansimesh_security_dispatch_v1
WHATSAPP_CLOUD_TEMPLATE_LANGUAGE=en_US
WHATSAPP_GRAPH_VERSION=v23.0

# Billing guard: auto-send is only permitted for free service text, never templates.
WHATSAPP_AUTO_SEND_FREE_ONLY=false
WHATSAPP_AUTO_SEND_DAILY_LIMIT=10

# AWS (set these, or use aws.local.ps1)
AWS_PROFILE=ahmad-dev
AWS_REGION=eu-west-1
SENTINEL_EVIDENCE_BUCKET=
SENTINEL_AUTO_PUBLISH_AWS=1
